{
    "$schema": "https://raw.githubusercontent.com/Exit-9B/MCM-Helper/main/docs/config.schema.json",
    "modName": "DynamicCombatCollision",
    "displayName": "$DCC_ModName",
    "cursorFillMode": "topToBottom",
    "pages": [
        {
            "pageDisplayName": "$DCC_Page",
            "cursorFillMode": "topToBottom",
            "content": [
                {
                    "text": "$DCC_Header_Settings",
                    "type": "header"
                },
                {
                    "text": "$DCC_Intro",
                    "type": "text"
                },
                {
                    "id": "bEnabled:Collision",
                    "text": "$DCC_Enabled",
                    "type": "toggle",
                    "help": "$DCC_Enabled_Help",
                    "valueOptions": {
                        "sourceType": "ModSettingBool"
                    }
                },
                {
                    "id": "bLockTargetOnly:Collision",
                    "text": "$DCC_LockOn",
                    "type": "toggle",
                    "help": "$DCC_LockOn_Help",
                    "valueOptions": {
                        "sourceType": "ModSettingBool"
                    }
                },
                {
                    "id": "bAllyCombatCollision:Collision",
                    "text": "$DCC_Ally",
                    "type": "toggle",
                    "help": "$DCC_Ally_Help",
                    "valueOptions": {
                        "sourceType": "ModSettingBool"
                    }
                },
                {
                    "id": "iCombatNpcCap:Collision",
                    "text": "$DCC_NpcCap",
                    "type": "slider",
                    "help": "$DCC_NpcCap_Help",
                    "valueOptions": {
                        "min": 1,
                        "max": 11,
                        "step": 1,
                        "sourceType": "ModSettingInt"
                    }
                },
                {
                    "id": "fCombatScale:Collision",
                    "text": "$DCC_Default",
                    "type": "slider",
                    "help": "$DCC_Default_Help",
                    "valueOptions": {
                        "min": 1.10,
                        "max": 5.00,
                        "step": 0.10,
                        "formatString": "{2}",
                        "sourceType": "ModSettingFloat"
                    }
                },
                {
                    "id": "bDebugDraw:Collision",
                    "text": "$DCC_ShowBox",
                    "type": "toggle",
                    "help": "$DCC_ShowBox_Help",
                    "valueOptions": {
                        "sourceType": "ModSettingBool"
                    }
                },
                {
                    "id": "bPlayerImmovable:Collision",
                    "text": "$DCC_NoPush",
                    "type": "toggle",
                    "help": "$DCC_NoPush_Help",
                    "valueOptions": {
                        "sourceType": "ModSettingBool"
                    }
                },
                {
                    "id": "bTranslationHelper:Collision",
                    "text": "$DCC_AttackTrans",
                    "type": "toggle",
                    "help": "$DCC_AttackTrans_Help",
                    "valueOptions": {
                        "sourceType": "ModSettingBool"
                    }
                },
                {
                    "id": "bWorldClipHelper:Collision",
                    "text": "$DCC_WorldClip",
                    "type": "toggle",
                    "help": "$DCC_WorldClip_Help",
                    "valueOptions": {
                        "sourceType": "ModSettingBool"
                    }
                },
                {
                    "text": "$DCC_Header_Weapons",
                    "type": "header"
                },
                {
                    "id": "fFist:Collision",
                    "text": "$DCC_Fist",
                    "type": "slider",
                    "help": "$DCC_Fist_Help",
                    "valueOptions": {
                        "min": 1.10,
                        "max": 5.00,
                        "step": 0.10,
                        "formatString": "{2}",
                        "sourceType": "ModSettingFloat"
                    }
                },
                {
                    "id": "fDagger:Collision",
                    "text": "$DCC_Dagger",
                    "type": "slider",
                    "help": "$DCC_Dagger_Help",
                    "valueOptions": {
                        "min": 1.10,
                        "max": 5.00,
                        "step": 0.10,
                        "formatString": "{2}",
                        "sourceType": "ModSettingFloat"
                    }
                },
                {
                    "id": "fSword:Collision",
                    "text": "$DCC_Sword",
                    "type": "slider",
                    "help": "$DCC_Sword_Help",
                    "valueOptions": {
                        "min": 1.10,
                        "max": 5.00,
                        "step": 0.10,
                        "formatString": "{2}",
                        "sourceType": "ModSettingFloat"
                    }
                },
                {
                    "id": "fLongsword:Collision",
                    "text": "$DCC_Longsword",
                    "type": "slider",
                    "help": "$DCC_Longsword_Help",
                    "valueOptions": {
                        "min": 1.10,
                        "max": 5.00,
                        "step": 0.10,
                        "formatString": "{2}",
                        "sourceType": "ModSettingFloat"
                    }
                },
                {
                    "id": "fWarhammer:Collision",
                    "text": "$DCC_Warhammer",
                    "type": "slider",
                    "help": "$DCC_Warhammer_Help",
                    "valueOptions": {
                        "min": 1.10,
                        "max": 5.00,
                        "step": 0.10,
                        "formatString": "{2}",
                        "sourceType": "ModSettingFloat"
                    }
                },
                {
                    "id": "fBattleaxe:Collision",
                    "text": "$DCC_Battleaxe",
                    "type": "slider",
                    "help": "$DCC_Battleaxe_Help",
                    "valueOptions": {
                        "min": 1.10,
                        "max": 5.00,
                        "step": 0.10,
                        "formatString": "{2}",
                        "sourceType": "ModSettingFloat"
                    }
                }
            ]
        }
    ]
}
